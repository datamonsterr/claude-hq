[Unit]
Description=Claude HQ bounded session, worktree and build-cache janitor

[Service]
Type=oneshot
WorkingDirectory=%h/dev/claude-hq
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/hq janitor --apply
Nice=19
IOSchedulingClass=idle
CPUWeight=10
MemoryMax=256M
# Janitor (120s) then gated gc (HQ_GC_TIMEOUT, 900s).
TimeoutStartSec=1050
TimeoutStopSec=10
