[Unit]
Description=Claude HQ bounded session and worktree janitor

[Service]
Type=oneshot
WorkingDirectory=%h/dev/claude-hq
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/hq janitor --apply
Nice=19
IOSchedulingClass=idle
CPUWeight=10
MemoryMax=256M
TimeoutStartSec=130
TimeoutStopSec=10
