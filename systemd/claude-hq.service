[Unit]
Description=Claude Code HQ Remote Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit WorkingDirectory if the checkout lives elsewhere; use absolute paths.
WorkingDirectory=%h/dev/claude-hq
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/claude remote-control --name HQ
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=default.target
