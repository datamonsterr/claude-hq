# Shell configuration; loaded only from ~/.config/claude-hq/config.env.
# Environment variables work too. Do not commit your configured copy.
HQ_ROOTS="$HOME/dev"
# Multiple roots: HQ_ROOTS="$HOME/dev:$HOME/projects"
# Optional Beszel v0.21 hub URL and a users-collection account:
BESZEL_URL=""
BESZEL_EMAIL=""
BESZEL_PASSWORD=""
# Spawn admission defaults (uncomment to tune):
# HQ_MAX_SESSIONS=40
# HQ_MIN_MEM_MB=3072
# HQ_MAX_LOAD=1.5
# Janitor defaults; it runs as a dry-run unless --apply is passed:
# HQ_DONE_HOURS=2
# HQ_IDLE_HOURS=12
# HQ_INTERACTIVE_HOURS=72
# HQ_JANITOR_STOP_INTERACTIVE=1
# HQ_WORKTREE_HOURS=1
# HQ_BRANCH_PREFIXES="hq/ so/ claude/ worktree-"
# HQ_TMP_DAYS=3
# HQ_TMP_PRESSURE_PCT=70
# HQ_SYSTEM_TMP_DAYS=2
# TMPDIR defaults to $HOME/.cache/tmp for scratch cleanup when unset.
# HQ_CALL_TIMEOUT=8
# HQ_JANITOR_TIMEOUT=120
# Build/disk gc (hq gc; also run by janitor --apply and the Claude SessionEnd hook):
# HQ_GC_DISK_PCT=70
# HQ_GC_GO_GB=10
# HQ_GC_IDLE_MINUTES=60
# HQ_GC_TIMEOUT=900
